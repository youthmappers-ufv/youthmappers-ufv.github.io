[{"id":"2022-07-09-mapatona-angra","titulo":"Mapatona Angra dos Reis","descricao":"O projeto foi criado para priorizar o mapeamento de feições em áreas de risco geológico, considerando os frequentes desastres ocorridos nesta região do estado do Rio de Janeiro, como os deslizamentos que aconteceram em Angra dos Reis em abril de 2022, com maior atenção ao bairro Monsuaba, que foi o mais atingido e que vitimou, fatalmente, 11 pessoas.","data":"2022-07-09","data_fim":null,"horario":"21h às 23h","hora_inicio":"21:00","hora_fim":"23:00","tipo":"mapatona","papel":"organizacao","modalidade":"remota","local":"Transmissão online pelo Google Meet","municipio":"Rio Paranaíba","imagem":"eventos/2022-07-09-mapatona-angra/capa.jpg","inscricao":null,"url":"eventos/2022-07-09-mapatona-angra/","inicio":"2022-07-09T21:00","fim":"2022-07-09T23:00","dia_inteiro":false,"lugar":"Transmissão online pelo Google Meet","tipo_nome":"Mapatona","cor":"#7a1f21","cor_texto":"#ffffff","google":"https://calendar.google.com/calendar/render?action=TEMPLATE&text=Mapatona+Angra+dos+Reis&dates=20220709T210000%2F20220709T230000&details=O+projeto+foi+criado+para+priorizar+o+mapeamento+de+fei%C3%A7%C3%B5es+em+%C3%A1reas+de+risco+geol%C3%B3gico%2C+considerando+os+frequentes+desastres+ocorridos+nesta+regi%C3%A3o+do+estado+do+Rio+de+Janeiro%2C+como+os+deslizamentos+que+aconteceram+em+Angra+dos+Reis+em+abril+de+2022%2C+com+maior+aten%C3%A7%C3%A3o+ao+bairro+Monsuaba%2C+que+foi+o+mais+atingido+e+que+vitimou%2C+fatalmente%2C+11+pessoas.%0A%0Ahttps%3A%2F%2Fyouthmappers-ufv.github.io%2Feventos%2F2022-07-09-mapatona-angra%2F&location=Transmiss%C3%A3o+online+pelo+Google+Meet&ctz=America%2FSao_Paulo","ics":"dados/painel/ics/2022-07-09-mapatona-angra.ics","termina":"2022-07-09"},{"id":"2022-07-19-oficina-importacao-dados-osm-postgis","titulo":"Oficina de Importação de Dados do OSM para o PostGIS usando o Osmosis","descricao":null,"data":"2022-07-19","data_fim":null,"horario":null,"hora_inicio":null,"hora_fim":null,"tipo